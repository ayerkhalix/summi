# npm run dev defaults to a real, single-process, in-memory room server.
# Local rooms are lost on server restart. Never use local mode for production.
SUMMIN_BACKEND=local

# For Supabase mode: apply supabase/migrations first, then set these SERVER ONLY keys.
# SUMMIN_BACKEND=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required for production. Exact public origin, e.g. https://summin.example.com.
# Development checks the incoming browser Host (localhost, 127.0.0.1 or LAN).
APP_ORIGIN=http://localhost:3000
# Optional development tunnel hostnames for Next's asset origin guard (no scheme/port).
# DEV_ALLOWED_ORIGINS=my-preview.example.com
# Random 32+ character value for the scheduled maintenance endpoint.
CRON_SECRET=

# Optional: use a trusted reverse proxy's sanitized IP header for rate limiting.
# TRUST_PROXY=true
# PROXY_IP_HEADER=x-real-ip

# Optional integration tests against an isolated, migrated Supabase test project.
# SUPABASE_TEST_URL=
# SUPABASE_TEST_SERVICE_ROLE_KEY=
# SUPABASE_TEST_ANON_KEY=
